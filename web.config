<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true"><files><clear /><add value="index.html" /></files></defaultDocument>
    <staticContent><remove fileExtension=".webp" /><mimeMap fileExtension=".webp" mimeType="image/webp" /></staticContent>
    <rewrite><rules><rule name="Hide index.html" stopProcessing="true"><match url="^index\.html$" /><action type="Redirect" url="/" redirectType="Permanent" /></rule></rules></rewrite>
  </system.webServer>
</configuration>
